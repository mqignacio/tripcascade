# TripCascade environment configuration.
# Copy to .env and fill in real values. NEVER commit .env (it is gitignored).
# Read programmatically (os.environ); never pass secrets as CLI flags.

# --- ATRIP Sandbox REST credentials (webhook/incident + aftercare APIs) ---
# Generated in ATRIP -> My Profile -> Sandbox credentials.
# Used as x-atlas-client-id / x-atlas-client-secret headers (see doc/atlas_surface.md §2.3).
ATLAS_SANDBOX_ACCESS_KEY=
ATLAS_SANDBOX_SECRET_KEY=
ATLAS_SANDBOX_BASE_URL=https://sandbox.atriptech.com

# --- ATRIP Production (leave blank in dev; Sandbox only for the hackathon) ---
ATLAS_PRODUCTION_ACCESS_KEY=
ATLAS_PRODUCTION_SECRET_KEY=
ATLAS_PRODUCTION_BASE_URL=https://api-sg.atriptech.com

# --- Bounded-autonomy settlement policy (FR-006) ---
# Auto-settle at or below this cap (cents); human approval above. Default S$50 = 5000 cents.
SETTLEMENT_CAP_CENTS=5000

# --- Disruption Watcher (FR-003) ---
# Scheduled forecast-poll interval (P0 trigger). Webhook/incident poll is P1 stretch.
WATCHER_POLL_INTERVAL_SECONDS=900
# Atlas incident poll endpoint (best-effort; see doc/atlas_surface.md §3).
ATLAS_INCIDENT_PATH=/event/getPageList.do

# --- Model-tier routing (FR-009) ---
# Routine: parse/format/entity-extraction. Hard: cascade reasoning, fare-diff logic.
# Model names from resources/qoder-model.md (Qoder frontier list):
#   Qwen3.7-Plus (0.1x) = routine; Qwen3.8-Max (0.5x) = hard.
# (PRD's "Qwen-Plus" maps to the available Qwen3.7-Plus.)
ROUTINE_MODEL=Qwen3.7-Plus
HARD_MODEL=Qwen3.8-Max
LOCAL_FALLBACK_MODEL=local-open-weight

# --- LLM backend (FR-009) ---
# stub = deterministic (default; tests + offline demo). dashscope = real Qwen via qwen-agent.
# Without DASHSCOPE_API_KEY the router falls back to local-open-weight (exercised in tests).
TRIPCASCADE_LLM_BACKEND=stub
DASHSCOPE_API_KEY=

# --- Orchestrator loop safety (cure for infinite-loop) ---
TRIPCASCADE_STEP_BUDGET=12
TRIPCASCADE_GIVE_UP_AFTER=12

# --- Forecast alert threshold (FR-003; from src/tripcascade/forecast/artifacts) ---
ALERT_THRESHOLD=0.35

# --- Runtime logs (decision-learning log; gitignored, regenerated by the demo) ---
DECISION_LOG_PATH=logs/decision_log.jsonl
AUDIT_LOG_PATH=logs/audit_log.jsonl

# --- Cloud deploy (tasks/05-cloud_deploy.md) ---
ALIBABA_FC_ENDPOINT=
